{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/retreats/molten-magic",
      "destination": "/retreats/alpine-pause",
      "permanent": false
    },
    {
      "source": "/fr/retraites/molten-magic",
      "destination": "/fr/retraites/alpine-pause",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
